PUBLIC_URL=https://sync.example.com
GIBSYNC_SERVER_SECRET=generate-another-random-32-byte-secret
# Legacy/default storage values are used to migrate pre-0.2 vaults.
SEAFILE_URL=http://seafile
SEAFILE_PUBLIC_URL=https://seafile.example.com
SEAFILE_USERNAME=you@example.com
SEAFILE_PASSWORD=your-seafile-password
SEAFILE_LIBRARY=Gib Sync
# Comma-separated host:port allowlist accepted during per-vault setup.
SEAFILE_ALLOWED_HOSTS=seafile.example.com
GIBSYNC_DATA_PATH=./data
TZ=UTC
